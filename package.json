    "clsx": "^2.1.1",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "next": "14.2.35",
    "next-intl": "^3.26.3",
    "next-themes": "^0.4.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "prettier": "^3.4.2",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
