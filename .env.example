# Site identity — MUST be the exact production origin. Every URL in
# sitemap.xml, robots.txt, canonical tags, hreflang and JSON-LD is built from
# this value, so it has to match the real site domain 1:1.
# NOTE: only origins listed in VERIFIED_SITE_ORIGINS (lib/site.ts) are honoured;
# any other value is ignored with a warning and the verified canonical domain
# is used instead. To migrate to a custom domain: connect it, verify its DNS
# resolves, add it to VERIFIED_SITE_ORIGINS, then update this variable.
NEXT_PUBLIC_SITE_URL=https://piclizer.vercel.app
NEXT_PUBLIC_SITE_NAME=Piclizer

# SEO / Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics (disabled by default — loads only after user consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Advertising (disabled by default — loads only after user consent)
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADS_CLIENT_ID=

# Monetag — Vignette Banner (loads immediately, no consent gate; leave empty
# to keep the default zone id 11719435 from the Monetag dashboard).
# You can replace it with the numeric zone id from your Monetag dashboard
# ("Get tag" for the Vignette Banner zone).
NEXT_PUBLIC_MONETAG_VIGNETTE_ZONE_ID=11719435

# Contact form endpoint (optional; form is inert until this is set).
# Publicly visible endpoint URL that accepts POST {name, email, message}.
NEXT_PUBLIC_CONTACT_ENDPOINT=
